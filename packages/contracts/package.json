{
  "name": "@duplexd/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./conformance": {
      "types": "./dist/src/conformance/index.d.ts",
      "default": "./dist/src/conformance/index.js"
    }
  },
  "bin": {
    "duplexd-conformance": "./dist/src/conformance/cli.js"
  },
  "files": [
    "dist",
    "fixtures",
    "schema"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b && node dist/scripts/build-schema.js",
    "lint": "eslint .",
    "schema:check": "node dist/scripts/check-schema.js",
    "test": "vitest run",
    "test:live": "node -e \"console.log('No live provider tests required for contracts.')\"",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "ajv": "8.17.1"
  }
}
