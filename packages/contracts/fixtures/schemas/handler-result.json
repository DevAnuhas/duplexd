{
  "cases": [
    {
      "name": "thinking",
      "value": {
        "kind": "thinking",
        "content": "Checking."
      },
      "expected": "valid",
      "schema": "HandlerResult"
    },
    {
      "name": "commentary",
      "value": {
        "kind": "commentary",
        "content": "Confirmed."
      },
      "expected": "valid",
      "schema": "HandlerResult"
    },
    {
      "name": "instruction",
      "value": {
        "kind": "instruction",
        "content": "Ask for the date."
      },
      "expected": "valid",
      "schema": "HandlerResult"
    },
    {
      "name": "done",
      "value": {
        "kind": "done"
      },
      "expected": "valid",
      "schema": "HandlerResult"
    },
    {
      "name": "error",
      "value": {
        "kind": "error",
        "message": "upstream failed"
      },
      "expected": "valid",
      "schema": "HandlerResult"
    },
    {
      "name": "content at exactly MAX_CONTENT_CHARS",
      "value": {
        "kind": "commentary",
        "content": ""
      },
      "expected": "valid",
      "schema": "HandlerResult"
    },
    {
      "name": "content one character over MAX_CONTENT_CHARS",
      "value": {
        "kind": "commentary",
        "content": ""
      },
      "expected": "invalid",
      "schema": "HandlerResult"
    },
    {
      "name": "known kind tolerates an extra field",
      "value": {
        "kind": "commentary",
        "content": "Confirmed.",
        "traceId": "abc"
      },
      "expected": "valid",
      "schema": "HandlerResult"
    },
    {
      "name": "done tolerates an extra field",
      "value": {
        "kind": "done",
        "traceId": "abc"
      },
      "expected": "valid",
      "schema": "HandlerResult"
    },
    {
      "name": "unknown kind",
      "value": {
        "kind": "mystery",
        "content": "x"
      },
      "expected": "invalid",
      "schema": "HandlerResult"
    },
    {
      "name": "content variant without content",
      "value": {
        "kind": "commentary"
      },
      "expected": "invalid",
      "schema": "HandlerResult"
    },
    {
      "name": "error without a message",
      "value": {
        "kind": "error"
      },
      "expected": "invalid",
      "schema": "HandlerResult"
    },
    {
      "name": "content is not a string",
      "value": {
        "kind": "commentary",
        "content": 12
      },
      "expected": "invalid",
      "schema": "HandlerResult"
    },
    {
      "name": "kind missing",
      "value": {
        "content": "x"
      },
      "expected": "invalid",
      "schema": "HandlerResult"
    }
  ]
}
