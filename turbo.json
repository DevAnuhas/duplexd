{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "schema/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["//#lint:root"]
    },
    "//#lint:root": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "build", "//#test:scripts"],
      "outputs": ["coverage/**"]
    },
    "//#test:scripts": {
      "cache": false
    },
    "test:live": {
      "dependsOn": ["build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
