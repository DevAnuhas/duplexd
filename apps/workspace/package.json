{
  "name": "workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types src/db/migrate.ts",
    "dev": "next dev",
    "lint": "eslint --max-warnings=0 .",
    "seed:riley": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/seed-riley.ts",
    "start": "rm -rf .next/standalone/apps/workspace/.next/static && cp -R .next/static .next/standalone/apps/workspace/.next/static && node .next/standalone/apps/workspace/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@better-auth/core": "1.7.5",
    "@hookform/resolvers": "5.9.1",
    "@phosphor-icons/react": "2.1.10",
    "ajv": "8.20.0",
    "better-auth": "1.7.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "pg": "8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "resend": "6.28.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "30.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.10",
    "jsdom": "30.1.0",
    "tailwindcss": "^4.3.3",
    "vitest": "5.0.1"
  }
}
