{
  "name": "workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build && pnpm run build:migrate",
    "build:migrate": "esbuild src/db/migrate.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/migrate.mjs --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types src/db/migrate.ts",
    "dev": "next dev",
    "lint": "eslint --max-warnings=0 .",
    "start": "cp -R .next/static .next/standalone/apps/workspace/.next/static && node .next/standalone/apps/workspace/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "vitest": "5.0.1"
  }
}
