OPENAI_API_KEY=
# Backend text model for the delegation worker, called through the Responses API. Must support function tools there.
BACKEND_MODEL=gpt-5.6-luna
# Seconds the mock webhook sleeps before answering. 5 is the gate's default.
WEBHOOK_DELAY_SECS=5
# How long a delegation may run before Pipecat abandons it.
DELEGATION_TIMEOUT_SECS=30
