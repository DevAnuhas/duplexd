# Every variable the workspace app reads. No values. Five app-wide prerequisites
# fail runtime initialization when missing; CALL_SWEEP_TOKEN is checked by its
# route alone; the final loopback flag is optional and safely defaults off.

# PostgreSQL connection string. A Neon branch per developer is the documented
# default; any PostgreSQL 17 or newer works, because nothing special-cases what
# answers this. Never defaulted: an unset or empty value aborts rather than
# connecting to whatever database happens to be listening locally.
DATABASE_URL=

# Signing secret for Better Auth sessions.
BETTER_AUTH_SECRET=

# Public origin the app is served from, e.g. http://localhost:3000. Better Auth
# uses it to build callback and cookie URLs. Required: it is never derived from
# the request, because behind a proxy the Host header would decide what this
# deployment thinks it is.
BETTER_AUTH_URL=

# 32 bytes of random data, hex-encoded (64 characters), protecting assistants'
# webhook secrets at rest. Generate with: openssl rand -hex 32
ASSISTANT_SECRET_KEY=

# Pipecat Cloud public API key. Used server-side to start the deployed agent;
# it is never sent to a customer or to the running agent.
PIPECAT_API_KEY=

# The four values below, together with PIPECAT_API_KEY, enable Sandbox voice
# calls on this deployment (ADR 015). All five or none: a deployment missing
# any of them answers 503 from Sandbox start, join and presence, and the
# workspace shows Start as unavailable rather than offering it.
#
# Pipecat Cloud private API key, used only to read and terminate sessions.
# It must differ from PIPECAT_API_KEY; the same value in both is a paste error
# that would hand session-termination authority to the start path.
PIPECAT_PRIVATE_API_KEY=

# The UUIDs identifying the deployed agent, used to prove that a session the
# provider reports is one of ours before it is read, joined or terminated.
# Read them from the private API, not from the dashboard's display names:
#   GET https://api.pipecat.daily.co/v1/agents
#   GET https://api.pipecat.daily.co/v1/agents/duplexd-agent
#
# NOT the Pipecat namespace. `PIPECAT_ORGANIZATION` in a CLI profile holds a
# slug; this is the UUID that appears in session responses, and a slug here
# would fail every ownership comparison.
PIPECAT_ORGANIZATION_ID=
PIPECAT_SERVICE_ID=
# The active deployment. It changes on every `pipecat cloud deploy`, and a
# stale value makes the platform disown the sessions it just started.
PIPECAT_DEPLOYMENT_ID=

# Optional. The HTTPS origin the agent calls back on for /v1/agent/* and
# /v1/practice/*. Defaults to BETTER_AUTH_URL, which is correct everywhere
# except local development: the browser needs localhost for cookies, and the
# agent runs on Pipecat Cloud, cannot resolve localhost, and is refused a
# non-HTTPS apiBase. Set it to an HTTPS tunnel for a local voice call.
SANDBOX_AGENT_API_BASE=

# High-entropy bearer token accepted only in the Authorization header by the
# external call-state sweeper. Generate with: openssl rand -base64 32
CALL_SWEEP_TOKEN=

# Optional. Allows an assistant's server URL to point at loopback --
# http://localhost, http://127.0.0.1, http://[::1] -- for local development.
# Set to the literal "true" to open it.
#
# Off unless set, deliberately. A webhook is called from the platform's own
# network, so a private, loopback or link-local target is not the customer's
# service but ours; 169.254.169.254 in particular is the cloud instance
# metadata endpoint. A default-on dev exception is a production hole waiting
# for someone to not set the variable.
#
# This check covers literal addresses only. A hostname that resolves to a
# private address is refused at egress by the agent, not here -- see #27.
ALLOW_LOOPBACK_SERVER_URL=
